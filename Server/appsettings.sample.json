{
  // ---------------------------------------------------------------------------
  // appsettings.sample.json
  //
  // Template for the real config files. Copy this file to one or more of:
  //   - appsettings.json              (base defaults, loaded always)
  //   - appsettings.Development.json  (loaded when ASPNETCORE_ENVIRONMENT=Development)
  //   - appsettings.Production.json   (loaded when ASPNETCORE_ENVIRONMENT=Production)
  // then fill in the real values. Those files are gitignored so your secrets
  // stay out of the repo.
  //
  // Prefer .NET user-secrets for local dev:
  //   cd Server
  //   dotnet user-secrets init
  //   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "..."
  //   dotnet user-secrets set "Jwt:Key" "..."
  // ---------------------------------------------------------------------------

  "ConnectionStrings": {
    // SQL Server connection string.
    // Local dev default (uses LocalDB, no credentials needed):
    //   "Server=(localdb)\\MSSQLLocalDB;Database=BenBotInventory;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
    // Hosted example:
    //   "Data Source=YOUR_SERVER;Initial Catalog=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;"
    "DefaultConnection": "REPLACE-WITH-YOUR-CONNECTION-STRING"
  },

  "Jwt": {
    // Signing key for issued JWTs. MUST be at least 32 characters of
    // high-entropy random data. Generate one with, e.g.:
    //   [Convert]::ToBase64String((1..48 | %{ Get-Random -Max 256 }))
    "Key": "REPLACE-WITH-A-LONG-RANDOM-SECRET-AT-LEAST-32-CHARS",
    "Issuer": "BenBotInventory",
    "Audience": "BenBotInventory"
  },

  "Messenger": {
    // Shared secret sent by the Chrome extension in the X-Bot-Token header.
    // Generate a long random string and paste the SAME value into the
    // extension's options page. Leave blank to disable the bridge.
    "BotToken": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
