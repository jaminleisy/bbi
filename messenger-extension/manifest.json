{
  "manifest_version": 3,
  "name": "BenBot Messenger Bridge",
  "version": "0.2.12",
  "description": "Copies Facebook Messenger conversations (including Marketplace) into the BenBot Inventory API. Does not send replies.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.messenger.com/*",
    "https://www.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://*.cdninstagram.com/*",
    "http://localhost/*",
    "https://localhost/*",
    "http://benleisy-001-site3.etempurl.com/*",
    "https://benleisy-001-site3.etempurl.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.messenger.com/*",
        "https://www.facebook.com/messages/*",
        "https://www.facebook.com/marketplace/inbox/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.messenger.com/*",
        "https://www.facebook.com/messages/*",
        "https://www.facebook.com/marketplace/inbox/*"
      ],
      "js": ["injected.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "BenBot Messenger Bridge",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": [
        "https://www.messenger.com/*",
        "https://www.facebook.com/*"
      ]
    }
  ]
}
